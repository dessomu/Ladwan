# ==============================================================================
# Ladwan Chakki Ecosystem — Centralized Firebase Environment Configuration
# ==============================================================================
# Copy this file to `.env.local` inside any app (e.g., apps/admin-mills/.env.local)
#
# NOTE: If these variables are omitted, all 4 apps automatically operate in
# interactive Demo / LocalStorage mode with full UI functionality and zero setup.
#
# To connect to a live Firebase & Cloud Firestore instance:
# 1. Go to https://console.firebase.google.com/ and create a project (e.g., "ladwan-chakki")
# 2. Enable "Email/Password" under Authentication -> Sign-in method
# 3. Enable Cloud Firestore in "production" or "test" mode
# 4. Register a Web App in Project Settings and paste the keys below:

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
