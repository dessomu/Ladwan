rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Users collection ──
    // Public read for customer/admin lookups; update allowed for authenticated user or demo profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() || userId.matches('^usr_.*');
    }

    // ── Mills collection ──
    // Public read so customer app and delivery app can see mills, live rates, and open/closed status.
    match /mills/{millId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || millId.matches('^mill_.*');
      allow delete: if false;

      // Mill inventory subcollection (active attas and grains per mill)
      // Path: mills/{millId}/inventory/{productId}
      match /inventory/{productId} {
        allow read, write: if true;
      }

      // Mill products subcollection (legacy alias)
      match /products/{productId} {
        allow read, write: if true;
      }

      // Mill daily ledger subcollection
      match /daily_ledger/{ledgerId} {
        allow read, write: if true;
      }
    }

    // ── Orders collection ──
    // Customers place orders; mill owners and delivery fleet read and update live order status.
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if false; // Orders are preserved for accounting / audit
    }

    // ── Notifications collection ──
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // ── Reviews collection (Customer post-delivery ratings and reviews) ──
    match /reviews/{reviewId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}

